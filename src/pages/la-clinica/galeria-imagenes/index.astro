---
import "/src/styles/global.css";
import Layout from '../../../layouts/Layout.astro';
import Footer from "../../../components/footer.astro";
import Header from "../../../components/Header.astro";
import Banner from "../../../components/Banner.astro";
import PrincipalImagen from "../../../components/PrincipalImage.astro";
import img1 from "../../../assets/galeria-fotos/img1.jpg";
import img2 from "../../../assets/galeria-fotos/img2.jpg";
import img3 from "../../../assets/galeria-fotos/img3.jpg";
import img4 from "../../../assets/galeria-fotos/img4.jpg";
import img5 from "../../../assets/galeria-fotos/img5.jpg";
import img6 from "../../../assets/galeria-fotos/img6.jpg";
import img7 from "../../../assets/galeria-fotos/img7.jpg";
import img8 from "../../../assets/galeria-fotos/img8.jpg";
import img9 from "../../../assets/galeria-fotos/img9.jpg";
---
<Layout>
    <Banner/>
    <Header/>
    <PrincipalImagen/>  
    <div id="clinic-gallery" class="bg-white min-h-screen pt-6 md:pt-10 pb-20 px-[10%] py-10 overflow-hidden flex flex-wrap justify-center gap-5">
        <div class="w-full sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1rem)]">
            <img src={img1.src} class="object-cover hover:border-5 border-pink-800 hover:scale-90" alt="Imagen de la Clínica">
        </div>
        <div class="sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1rem)] ">
            <img src={img2.src} class="object-cover hover:border-5 border-pink-800 hover:scale-90" alt="Imagen de la Clínica">
        </div>
        <div class="sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1rem)] ">
            <img src={img3.src} class="object-cover hover:border-5 border-pink-800 hover:scale-90" alt="Imagen de la Clínica">
        </div>
        <div class="sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1rem)] ">
            <img src={img4.src} class="object-cover hover:border-5 border-pink-800 hover:scale-90" alt="Imagen de la Clínica">
        </div>
        <div class="sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1rem)] ">
            <img src={img5.src} class="object-cover hover:border-5 border-pink-800 hover:scale-90" alt="Imagen de la Clínica">
        </div>
        <div class="sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1rem)] ">
            <img src={img6.src} class="object-cover hover:border-5 border-pink-800 hover:scale-90" alt="Imagen de la Clínica">
        </div>
        <div class="sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1rem)] ">
            <img src={img7.src} class="object-cover hover:border-5 border-pink-800 hover:scale-90" alt="Imagen de la Clínica">
        </div>
        <div class="sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1rem)] ">
            <img src={img8.src} class="object-cover hover:border-5 border-pink-800 hover:scale-90" alt="Imagen de la Clínica">
        </div>
        <div class="sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1rem)] ">
            <img src={img9.src} class="object-cover hover:border-5 border-pink-800 hover:scale-90" alt="Imagen de la Clínica">
        </div>
    </div>
    <Footer />
    <Footer />
    <div id="image-modal" class="fixed inset-0 bg-black/80 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300 pointer-events-none cursor-pointer">
        <!-- El max-w-[90vw] ya controla que no se salga de la pantalla -->
        <div id="modal-content" class="relative max-w-[70vw] md:w-[90vw] md:h-[90vh] bg-white p-2 md:p-4 rounded-lg shadow-2xl scale-95 transition-transform duration-300 cursor-default flex flex-col items-center w-fit max-w-[95vw] max-h-[95vh]">
            <button id="close-modal" class="absolute top-2 right-2 text-gray-700 hover:text-black focus:outline-none z-50 p-2 bg-white/70 ">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
            <img id="modal-image" src="" alt="" class="max-h-[50vh] w-auto md:max-h-[80vh] md:w-auto lg:min-w-[50vw]">
            <p class="italic text-sm md:text-lg mt-2 text-gray-800">IMAGEN DE LA CLÍNICA</p>
        </div>
    </div>
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const gallery = document.getElementById('clinic-gallery');
            const modal = document.getElementById('image-modal');
            const modalImage = document.getElementById('modal-image');
            const closeButton = document.getElementById('close-modal');
            const modalContent = document.getElementById('modal-content');

            function openModal(targetImage) {
                const src = targetImage.getAttribute('src');
                const alt = targetImage.getAttribute('alt');
                modalImage.setAttribute('src', src);
                modalImage.setAttribute('alt', alt);
                modal.classList.remove('hidden', 'pointer-events-none', 'opacity-0');
                modal.classList.add('opacity-100'); // Opacidad normal (0 a 100)
                document.body.style.overflow = 'hidden';

                setTimeout(() => {
                    modalContent.classList.remove('scale-95');
                    modalContent.classList.add('scale-100'); // Regresa a su tamaño original (100%)
                }, 10);
            }

            function closeModal() {
                modal.classList.add('opacity-0', 'pointer-events-none');
                modal.classList.remove('opacity-100');
                
                modalContent.classList.add('scale-95');
                modalContent.classList.remove('scale-100');
                
                document.body.style.overflow = '';

                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            }

            // Listener para las imágenes
            const images = gallery.querySelectorAll('img');
            images.forEach(image => {
                image.classList.add('cursor-pointer');
                image.addEventListener('click', (e) => openModal(e.target));
            });

            closeButton.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
        });
    </script>
</Layout>