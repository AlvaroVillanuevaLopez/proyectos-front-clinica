---
import "/src/styles/global.css";
import Layout from '../../layouts/Layout.astro';

import fotoGaleria from "../../assets/fotos-laclinica/fotoGaleria.jpg";
import logoX from "../../assets/logos-rrss/logo-x.png";
import logoGmail from "../../assets/logos-rrss/logo-gmail.webp";
const clinicData = {
  image: {
    src: "/path-to-your-image.jpg",
    alt: "Interior Clínica",
    title: "Galería de Imágenes"
  }
};

const parrafos=`En la <strong class='font-bold text-[#444]'>Clínica 57</strong> sabemos la importancia que tiene la salud bucodental. Para ello, ponemos a disposición de nuestros pacientes las últimas <strong class='font-bold text-[#444]'>innovaciones odontológicas</strong> con el objetivo de devolver y mantener la salud oral y la belleza de su sonrisa. <strong class='font-bold text-[#444]'>Situados en pleno barrio de Salamanca</strong>, en la <strong class='font-bold text-[#444]'>Clínica Hermosilla 57</strong> aunamos la <strong class='font-bold text-[#444]'>atención personalizada y exclusiva</strong> al paciente con la calidad y la más avanzada y moderna tecnología odontológica.

Nuestro compromiso es ofrecer tratamientos de vanguardia, con los <strong class='font-bold text-[#444]'>mejores materiales</strong>, logrando la <strong class='font-bold text-[#444]'>máxima excelencia</strong> en nuestros resultados.

Desde la primera consulta, en Clínica Hermosilla 57, realizamos un <strong class='font-bold text-[#444]'>diagnóstico concreto</strong> de sus necesidades bucodentales y un plan de tratamiento personalizado para solucionar sus problemas rápida y eficazmente.

Además, la <strong class='font-bold text-[#444]'>Clínica Hermosilla 57</strong> cuenta con los mejores expertos en <strong class='font-bold text-[#444]'>odontología estética</strong> que le asesorarán sobre tratamientos de cosmética dental, como blanqueamientos o carillas.

Si busca una <strong class='font-bold text-[#444]'>clínica dental en el barrio de Salamanca</strong> en Madrid, venga a conocer nuestras instalaciones, nuestro compromiso con la calidad de los resultados y la discreción con la que tratamos a nuestros pacientes.`;
---
<Layout>
    
    <div class="bg-white min-h-screen pt-6 md:pt-10 pb-20">
    <section class="max-w-7xl mx-auto px-4 md:px-6 font-light text-[#777] leading-relaxed">

        <div class="text-lg md:text-2xl md:text-left flex flex-col gap-6">
            <p set:html={parrafos} class="whitespace-pre-line"></p>
        </div>

        <div class="flex gap-4 mt-8">
            <a target="_blank" href="http://x.com/?lang=es">
                <img src={logoX.src} alt="Logo X" class="w-8 h-8 md:w-10 md:h-10">
            </a>
            <a target="_blank" href="https://mail.google.com/">
                <img src={logoGmail.src} alt="Logo Gmail" class="w-8 h-8 md:w-10 md:h-10">
            </a>
        </div>

        <div class="relative max-w-3xl mx-auto mt-10 overflow-hidden transition duration-200 ease-in-out group hover:scale-105 rounded-lg">
            <img 
                src={fotoGaleria.src} 
                alt={clinicData.image.alt} 
                class="block w-full h-auto object-cover"
            />

            <div class="absolute bottom-0 left-0 w-full bg-[#485f75]/80 py-4 md:py-8 px-6 transition-colors duration-200 group-hover:bg-pink-800/90">
                <h2 class="text-white text-lg md:text-2xl tracking-widest uppercase text-center font-light">
                    {clinicData.image.title}
                </h2>
            </div>
        </div>

    </section>
</div>
    
</Layout>