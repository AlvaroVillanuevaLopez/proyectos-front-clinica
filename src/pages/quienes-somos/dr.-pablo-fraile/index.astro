---
import "/src/styles/global.css";
import Layout from '../../../layouts/Layout.astro';
import img1 from '../../../assets/specialties-images/PabloFrailes.jpg';
const name = "DR. PABLO FRAILE"
const description = `El Dr. Pablo Fraile es Licenciado en Odontología por la Universidad Europea de Madrid y Máster en Ortodoncia, Ortopedia Dentomaxilar y Cirugía Ortognática por la Universidad de Alcalá de Henares.

Miembro de la Sociedad Española de Medicina Oral del Sueño y de la Sociedad Española de Ortodoncia, el Dr. Fraile ejerce en la <b>Clínica Hermosilla 57</b> como odontólogo colegiado especializado en Ortodoncia.

El Dr. Fraile ha obtenido las certificaciones oficiales para poner en práctica las técnicas de ortodoncia más actuales: <b>Ortodoncia Lingual 3D, Invisalign, Roth, TIP-EDGE, Autoligable, MBT, DAMON SMART-CLIP, Hilgers e interceptiva</b> para niños.

El Dr. Fraile atiende consulta en castellano e inglés.`;
const dentists = [
        {
      name:'DRA.&nbsp;BERTA CARLEVARIS',
      src:'/src/assets/specialties-images/BertaCarlevaris.jpg',
      link:'../dra.-berta-carlevaris/'
    },
    {
      name:'DR.&nbsp;ENRIQUE LÓPEZ',
      src:'/src/assets/specialties-images/EnriqueLopez.jpg',
      link:'../dr.-enrique-lopez/'
    },
    {
      name:'DR.&nbsp;JAVIER MARTÍNEZ-SALMEÁN',
      src:'/src/assets/specialties-images/JavierMartinezSalmean.jpg',
      link:'../dr.-javier-martinez-salmean/'
    }
]
---

<Layout>
  <div class="px-[16%] max-[1000px]:flex-wrap max-[1000px]:flex-col py-20 overflow-hidden flex flex-row w-full">
    <div class="min-[1000px]:basis-6/8 flex flex-col items-start min-[1000px]:pr-20 ">
      <img src={img1.src} class="w-full max-h-[400px] object-contain"/>
      <h2 class="font-bold text-xl uppercase text-gray-600 mt-5 mb-10">{name}</h2>
        <span set:html={description} class="whitespace-pre-line font-light text-lg max-[600px]:text-sm"></span>
    </div>

    <div class="min-[1000px]:basis-2/8">
    <h2 class="w-full text-3xl border-b-3 text-pink-500 border-pink-500 font-lightbold pt-3 mb-5 max-[1050px]:text-sm">OTROS PROFESIONALES</h2>
        <div class="flex flex-col justify-center gap-8 px-[10%]">
          {dentists.map(dentist => (
            <div onclick={`window.location.href='${dentist.link}'`} class="cursor-pointer relative w-full hover:scale-105 transition group max-w-[350px]">
<img src={dentist.src} class="w-full h-[250px] max-[1500px]:h-[150px] max-h-[300px] object-cover object-top"/>
<div class="absolute bottom-0 left-0 right-0 bg-black/50 h-[70px] max-[600px]:h-[50px] group-hover:bg-pink-800/90 transition duration-200 text-white p-6">
                <p class="text-[8px] min-[1000px]:text-xs text-center" set:html={dentist.name}/>
              </div>
            </div>
          ))}
        </div>    
      </div>
  </div>
</Layout>