---
import imagenDefault from '../assets/images-background/eje.avif';
import el from '../assets/images-background/descarga.jpg';
const currentPath = Astro.url.pathname;
const contenido={
    imagen:"",
    titulo:""
}
if(currentPath.startsWith("/quienes-somos/")){
    contenido.imagen=imagenDefault.src;
    contenido.titulo="QUIENES SOMOS";
}else if(currentPath.startsWith("/la-clinica/")){
    contenido.imagen=el.src;
    contenido.titulo="LA CLÍNICA";
}else{
    contenido.imagen=el.src;
    contenido.titulo="ESPECIALIDADES Y TRATAMIENTOS";
}
---
<div 
  class="w-full py-20 bg-cover bg-center" 
  style={`background-image: url('${contenido.imagen}');`}
>
  <h1 class="text-center text-white text-5xl font-bold">
    {contenido.titulo}
  </h1>
</div>