---
import type { startsWith } from "astro:schema";

const currentPath = Astro.url.pathname;
const active = "bg-pink-600 text-white";
const inactive = "hover:text-gray-500";
---
<div id="header" class="bg-white max-w-6xl mx-auto xl:grid xl:grid-cols-12 py-4">

  <!-- Logo -->
  <div id="logo" class="xl:col-span-4 mt-5 mb-7">
    <a href="/"><img src="/logo/logo.png" alt="logo" /></a>
  </div>

  <!-- Menú con Alpine.js -->
  <div class="xl:col-span-8 xl:flex xl:items-center xl:justify-end" x-data="{ open: false }">

    <!-- Botón hamburguesa para pantallas pequeñas -->
    <div class="flex items-center xl:hidden">
      <button 
        type="button" 
        @click="open = !open" 
        class="text-gray-800 focus:outline-none"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Menú de pestañas -->
    <div 
      :class="{'block': open, 'hidden': !open}" 
      class="hidden flex-col xl:flex xl:flex-row xl:justify-end xl:items-center mt-2 xl:mt-0"
    >
      <div class={`pestana ${Astro.url.pathname === '/' ? 'bg-pink-600 text-white' : 'hover:text-gray-500'}`}>
        <a href="/">INICIO</a>
      </div>
      <div class={`pestana ${Astro.url.pathname.startsWith('/quienes-somos/') ? 'bg-pink-600 text-white' : 'hover:text-gray-500'}`}>
        <a href="/quienes-somos/">¿QUIENES SOMOS?</a>
      </div>
      <div class={`pestana w-10/45 ${Astro.url.pathname.startsWith('/especialidades-y-tratamientos/') ? 'bg-pink-600 text-white' : 'hover:text-gray-500'}`}>
        <a href="/especialidades-y-tratamientos/">ESPECIALIDADES Y TRATAMIENTOS</a>
      </div>
      <div class={`pestana ${Astro.url.pathname.startsWith('/la-clinica/') ? 'bg-pink-600 text-white' : 'hover:text-gray-500'}`}>
        <a href="/la-clinica/">LA CLINICA</a>
      </div>
      <div class={`pestana ${Astro.url.pathname.startsWith('/contacto/') ? 'bg-pink-600 text-white' : 'hover:text-gray-500'}`}>
        <a href="/contacto/">CONTACTO</a>
      </div>
    </div>

  </div>

</div>