---
import type { startsWith } from "astro:schema";

const currentPath = Astro.url.pathname;
const active = "bg-pink-600 text-white";
const inactive = "text-pink-600 hover:text-gray-500";
---
<div id="header" class="bg-white max-w-6xl mx-auto md:grid md:grid-cols-12 pt-4 pb-1   mt-20 md:mt-10">

  <!-- Logo -->
  <div id="logo" class="md:col-span-4 mt-5 mb-7">
    <a href="/"><img src="/logo/logo.png" alt="logo" /></a>
  </div>

  <!-- Menú con Alpine.js -->
  <div class="md:col-span-12 lg:flex lg:col-span-8 lg:justify-end" x-data="{ open: false }">

    <!-- Botón hamburguesa solo en móviles -->
    <div class="flex items-center md:hidden">
      <button 
        type="button" 
        @click="open = !open" 
        class="text-gray-800 focus:outline-none"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Menú de pestañas -->
    <div 
      :class="{'block': open, 'hidden': !open}" 
      class="hidden flex-col md:flex md:flex-row lg:justify-end md:items-center mt-2"
    >
      <div class={`pestana ${Astro.url.pathname === '/' ? active : inactive}`}>
        <a href="/">INICIO</a>
      </div>

      <div class={`pestana ${Astro.url.pathname.startsWith('/quienes-somos/') ? active : inactive}`}>
        <a href="/quienes-somos/">¿QUIENES SOMOS?</a>
      </div>

