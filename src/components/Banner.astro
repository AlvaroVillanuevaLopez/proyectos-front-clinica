---
import { Icon } from "astro-icon/components";

const correo = "recepcion@clinicahermosilla57.com";
const telefono = "+34 91 310 51 52";
---

<div class="fixed top-0 z-50 w-full bg-gray-100 py-2">
  <div class="max-w-6xl mx-auto md:grid md:grid-cols-4">
    <div class="font-semibold text-gray-500 md:flex md:items-center gap-6 md:col-span-3">

      <div class="flex items-center gap-2">
        <Icon name="heroicons:envelope" class="w-4 h-4" />
        <a href={`mailto:${correo}`} class="text-sm">{correo}</a>
      </div>

      <div class="flex items-center gap-2">
        <Icon name="heroicons:phone" class="w-4 h-4" />
        <a href={`tel:${telefono}`} class="text-xs">{telefono}</a>
      </div>

    </div>

    <div class="flex md:justify-end">
      <a href="/contacto/" class="px-5 py-2 bg-pink-600 hover:bg-pink-500 text-white font-semibold mt-2 md:mt-0">
        PEDIR CITA
      </a>
    </div>

  </div>
</div>